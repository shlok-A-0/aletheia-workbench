{
  "name": "aletheia-workbench",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "build": "tsc -b && tsc --noEmit -p tsconfig.server.json && vite build",
